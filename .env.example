# Copy to .env and fill in. Never commit .env.
MONGODB_URI=mongodb://localhost:27017
# For Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net
DB_NAME=restropulse_landing
PORT=3005

# --- Restaurant Intelligence deep-analysis (server/restrograde.js) ---
# Google Places API (New) must be ENABLED on the Google Cloud project.
GOOGLE_MAPS_API_KEY=
ANTHROPIC_API_KEY=
# Model overrides (defaults: opus-4-6 analysis, sonnet-5 benchmark; thinking off).
# Lower to claude-sonnet-5 / claude-haiku-4-5 to cut latency + cost per scan.
RESTROGRADE_ANALYSIS_MODEL=claude-opus-4-6
RESTROGRADE_BENCHMARK_MODEL=claude-sonnet-5
